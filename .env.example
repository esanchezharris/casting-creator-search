# Everything here is optional. With no key the app uses the rule-based parser
# and keyword ranking, so it runs out of the box.

# Any OpenAI-compatible endpoint works.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# EMBED_MODEL=text-embedding-3-small
# EMBED_DIMS=256

# Force the baselines even when a key is set (useful for the eval comparison).
# PARSER=rules
# RANKER=keywords

# Only for scripts/fetch_images.py (Unsplash, demo keys allow 50 requests an hour).
# UNSPLASH_ACCESS_KEY=
